{
  "manifest_version": 2,
  "name": "ARB Free Buyer",
  "version": "2.4.0",
  "description": "ARB Free Buyer - Automated order monitor and sniper for Payjora (OTP-UPI, UPI, BANK, Quick, USDT).",
  "permissions": [
    "storage",
    "tabs",
    "https://uidif.payjora.com/*"
  ],
  "browser_action": {
    "default_title": "ARB Free Buyer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://uidif.payjora.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}